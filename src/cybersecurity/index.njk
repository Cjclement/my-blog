<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>IT & Cybersecurity</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0d1117; color: #f0f6fc; padding: 32px 16px; max-width: 600px; margin: auto; }
    a { color: #58a6ff; text-decoration: none; }
    .back-btn { margin-bottom: 30px; display: inline-block; color: #8b949e; }
    .post-card { margin-bottom: 24px; padding: 16px; background: rgba(22, 27, 34, 0.75); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; }
    .post-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 8px; display: block; }
    .post-title:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <a href="/" class="back-btn">&larr; Back to Home</a>
  <h1 style="margin-bottom: 24px;">IT & Cybersecurity</h1>
  
  {% for post in collections.cybersecurity | reverse %}
    <div class="post-card">
      <a href="{{ post.url }}" class="post-title">{{ post.data.title }}</a>
    </div>
  {% else %}
    <p>No posts published yet.</p>
  {% endfor %}

</body>
</html>

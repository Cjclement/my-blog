<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0d1117; color: #f0f6fc; padding: 32px 16px; line-height: 1.6; max-width: 600px; margin: auto; }
    a { color: #58a6ff; text-decoration: none; }
    .back-btn { margin-bottom: 20px; display: inline-block; }
  </style>
</head>
<body>
  <a href="/" class="back-btn">&larr; Back to Home</a>
  <h1>{{ title }}</h1>
  <p><em>Published on {{ date }}</em></p>
  <hr style="border-color: #333; margin-bottom: 30px;">
  
  {{ content | safe }}
  
</body>
</html>